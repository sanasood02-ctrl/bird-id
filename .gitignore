# Virtual environment (Python + libraries for this project; can be rebuilt from requirements.txt)
.venv/

# Python's auto-generated cache files
__pycache__/

# macOS Finder metadata files
.DS_Store

# Secret API key -- must NEVER be committed
.streamlit/secrets.toml
# ...and renamed copies, like secrets.toml.off (the * matches anything after)
.streamlit/secrets.toml*

# Practice runs of the evaluation script with fake demo answers
eval/results_demo_*.csv
